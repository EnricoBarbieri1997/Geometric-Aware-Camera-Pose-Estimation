\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Assuming all the solhouette lines are visible, $\mathcal  {S}_1$ can be solved when the number of cylinders $M$ and the number of view $N$ satisfy $2MN>3N+5$. The red cells indicate infeasibility, while the green cells indicate feasibility. \bf  {Note}: for one cylinder, the problem is not feasible and for either 6 or more cylinders or 9 or more views, the problem is always feasible.\relax }}{6}{table.caption.5}\protected@file@percent }
\newlabel{tab:scene_configurations}{{1}{6}{Assuming all the solhouette lines are visible, \texorpdfstring {$\mathcal {S}_1$}{S1} can be solved when the number of cylinders \texorpdfstring {$M$}{M} and the number of view \texorpdfstring {$N$}{N} satisfy \texorpdfstring {$2MN>3N+5$}{2MN>3N+5}. The red cells indicate infeasibility, while the green cells indicate feasibility. \bf {Note}: for one cylinder, the problem is not feasible and for either 6 or more cylinders or 9 or more views, the problem is always feasible.\relax }{table.caption.5}{}}
